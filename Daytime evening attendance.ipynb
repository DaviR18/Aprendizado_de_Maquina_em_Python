   "source": [
    "import pandas as pd\n",
    "\n",
    "df = pd.read_csv(\"data_OneHot_Marital_status.csv\", sep=\";\")\n",
    "\n",
    "df.columns = df.columns.str.strip()\n",
    "\n",
    "df[\"Application mode\"] = df[\"Application mode\"].apply(\n",
    "    lambda x: \"daytime\" if x == 1\n",
    "    else \"evening\"\n",
    ")\n",
    "\n",
    "print(df[\"Application mode\"].value_counts())"
   ]
  }
